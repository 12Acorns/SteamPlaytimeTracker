<Window x:Class="SteamPlaytimeTracker.MVVM.View.Windows.ProcessTrackingSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SteamPlaytimeTracker.MVVM.View.Windows"
        xmlns:window="clr-namespace:SteamPlaytimeTracker.MVVM.ViewModel.Window"
        xmlns:windowchrome="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls.WindowChrome"
        xmlns:proc="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls.Process" xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=window:ProcessTrackingSelectionWindowModel}"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged"
        Topmost="False"
        Style="{DynamicResource DefaultWindowStyle}"
        Title="ProcessTrackingSelectionView" Height="450" Width="800">
    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="8" CaptionHeight="25" ResizeBorderThickness="3" />
    </WindowChrome.WindowChrome>
    <Grid Background="{StaticResource defaultGray}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <windowchrome:WindowChromeBar Title="{Binding Title}" SettingsButtonVisibility="Hidden" />
        <vwp:VirtualizingItemsControl Grid.Row="1" ItemsSource="{Binding ProcessView}" 
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingPanel.IsVirtualizing="True" />
    </Grid>
</Window>
