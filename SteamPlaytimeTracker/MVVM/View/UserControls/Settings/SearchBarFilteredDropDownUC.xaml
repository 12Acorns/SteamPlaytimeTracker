<UserControl x:Class="SteamPlaytimeTracker.MVVM.View.UserControls.Settings.SearchBarFilteredDropDownUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls.Settings"
             d:DataContext="{d:DesignInstance local:SearchBarFilteredDropDownUC}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" x:Name="SearchText"
                Background="{Binding SearchBarBackground, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                Foreground="{Binding SearchBarTextColour, RelativeSource={RelativeSource AncestorType=UserControl}}"
                TextChanged="TextBox_TextChanged"
                KeyDown="SearchText_KeyDown"
                TextWrapping="Wrap" />
        <ComboBox Grid.Row="1" x:Name="SearchContent" HorizontalContentAlignment="Right" TextBlock.TextAlignment="Right"
                ItemsSource="{Binding SearchItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                SelectedItem="{Binding SelectedSearchItem, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</UserControl>
