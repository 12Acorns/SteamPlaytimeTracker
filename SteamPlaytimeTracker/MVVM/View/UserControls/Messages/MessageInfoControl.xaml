<UserControl x:Class="SteamPlaytimeTracker.MVVM.View.UserControls.Messages.MessageInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls.Messages"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Source="{Binding IconPath}" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased" />
        <Border Grid.Column="1" BorderThickness="2,0,0,0" BorderBrush="Black">
            <TextBlock Text="{Binding MessageText}" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Left"
                       Foreground="LightGray" FontSize="14" TextWrapping="Wrap" />
            
        </Border>
    </Grid>
</UserControl>
