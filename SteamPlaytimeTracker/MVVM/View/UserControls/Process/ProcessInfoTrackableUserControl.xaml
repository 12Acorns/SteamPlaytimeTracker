<UserControl x:Class="SteamPlaytimeTracker.MVVM.View.UserControls.Process.ProcessInfoTrackableUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls.Process"
             xmlns:uc="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls" 
             d:DataContext="{d:DesignInstance Type=local:ProcessInfoTrackableUserControl}"
             mc:Ignorable="d"
             Background="Transparent"
             MinHeight="60"
             Height="60"
             MaxHeight="60"
             d:DesignHeight="60" d:DesignWidth="800">
    <Grid>
        <Border BorderThickness="0,0,0,1" BorderBrush="#99CCCCCC"/>
        <Grid Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <CheckBox Background="LightGray" IsChecked="{Binding ToggleState}"
                      HorizontalAlignment="Center" VerticalContentAlignment="Center">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="3" ScaleY="3" />
                </CheckBox.LayoutTransform>
            </CheckBox>
            <Grid Grid.Column="1" Margin="2,0,0,0" Background="{StaticResource defaultGray}">
                <TextBlock Foreground="LightGray" FontSize="14" Text="{Binding ProcessInfoText}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
