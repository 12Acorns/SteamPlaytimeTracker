<UserControl x:Class="SteamPlaytimeTracker.MVVM.View.HomeView"
             x:Name="homeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SteamPlaytimeTracker.MVVM.View" 
             xmlns:usercontrols="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls"
             xmlns:ucsteam="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls.Steam"
             xmlns:app="clr-namespace:SteamPlaytimeTracker.Steam.Data.App"
             xmlns:dbo="clr-namespace:SteamPlaytimeTracker.DbObject"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:global="clr-namespace:SteamPlaytimeTracker"
             xmlns:ext="clr-namespace:SteamPlaytimeTracker.Extensions" 
             xmlns:effects="clr-namespace:SteamPlaytimeTracker.Utility.Effects" 
             xmlns:viewmodel="clr-namespace:SteamPlaytimeTracker.MVVM.ViewModel" 
             d:DataContext="{d:DesignInstance Type=viewmodel:HomeViewModel}"
             mc:Ignorable="d" 
             Background="Transparent"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <!-- Header bar -->
        <Grid Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="0.05*" MinWidth="60" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>

                <usercontrols:ExtendedButton Background="Transparent" BorderThickness="0" Command="{Binding PlaytimeOrderButtonCommand}">
                    <Image Source="{Binding PlaytimeOrderImagePath}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           MinHeight="20" MinWidth="20"/>
                </usercontrols:ExtendedButton>
                <usercontrols:ExtendedButton Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Command="{Binding NameOrderButtonCommand}">
                    <Image Source="{Binding NameOrderImagePath}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        MinHeight="20" MinWidth="20"/>
                </usercontrols:ExtendedButton>
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding CurrentSortType}" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="LightGray" FontSize="18" />
        </Grid>
        <vwp:GridView x:Name="lb_SteamEntries" Grid.Row="1" ItemsSource="{Binding SteamAppsView}"
                      ItemContainerStyle="{StaticResource LBI_NoOutline}" 
                      ItemTemplate="{StaticResource SteamAppEntryDataTemplate}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" 
                      VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="Transparent" Foreground="Transparent" 
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="2" VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.VirtualizationMode="Recycling" BorderThickness="0"
                      SizeChanged="ListBox_SizeChanged">
            <vwp:GridView.Resources>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource darkThemeScrollViewer}" />
            </vwp:GridView.Resources>
        </vwp:GridView>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <usercontrols:ExtendedButton Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Background="Transparent" Foreground="LightGray" HoverBackground="Transparent" HoverBorder="Transparent"
                             BorderBrush="Transparent" Command="{Binding ExportDataCommand}">
                <usercontrols:ExtendedButton.Content>
                    <Path Data="{StaticResource ExportFileSVGData}" 
                       StrokeThickness="0.2" Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                       Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type usercontrols:ExtendedButton}}}"
                       Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type usercontrols:ExtendedButton}}}"
                       Stretch="Uniform" StrokeEndLineCap="Flat" StrokeStartLineCap="Flat" />
                </usercontrols:ExtendedButton.Content>
            </usercontrols:ExtendedButton>
            <usercontrols:ExtendedButton Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="Transparent" HoverBackground="Transparent" HoverBorder="Transparent"
                  Foreground="LightGray" BorderBrush="Transparent" Command="{Binding ImportDataCommand}">
                <usercontrols:ExtendedButton.Content>
                    <Path Data="{StaticResource ImportFileSVGData}" 
                       StrokeThickness="0.2" Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                       Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type usercontrols:ExtendedButton}}}"
                       Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type usercontrols:ExtendedButton}}}"
                       Stretch="Uniform" StrokeEndLineCap="Flat" StrokeStartLineCap="Flat" />
                </usercontrols:ExtendedButton.Content>
            </usercontrols:ExtendedButton>
            <TextBlock Grid.Column="2" Text="{Binding FooterText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Foreground="LightGray" FontSize="12" Margin="5,0,0,0" FontStyle="Italic"/>
            <usercontrols:ExtendedButton Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Background="Transparent" HoverBackground="Transparent" HoverBorder="Transparent"
                                         BorderBrush="Transparent" Command="{Binding OpenMessageMenu}">
                <usercontrols:ExtendedButton.Content>
                    <Image Source="/resources/Info_Icon.png" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.Effect>
                            <effects:InvertEffect />
                        </Image.Effect>
                    </Image>
                </usercontrols:ExtendedButton.Content>
            </usercontrols:ExtendedButton>
            <usercontrols:ExtendedButton Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="Transparent" HoverBackground="Transparent" HoverBorder="Transparent"
                              Foreground="LightGray" BorderBrush="Transparent" Command="{Binding OpenProcessTrackingMenu}">
                <usercontrols:ExtendedButton.Content>
                    <Path Data="{StaticResource ProcessesSVGData}" 
                       StrokeThickness="0.2" Margin="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                       Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type usercontrols:ExtendedButton}}}"
                       Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type usercontrols:ExtendedButton}}}"
                       Stretch="Uniform" StrokeEndLineCap="Flat" StrokeStartLineCap="Flat" />
                </usercontrols:ExtendedButton.Content>
            </usercontrols:ExtendedButton>
        </Grid>
    </Grid>
</UserControl>
