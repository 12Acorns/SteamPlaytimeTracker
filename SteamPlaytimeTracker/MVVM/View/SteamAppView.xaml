<UserControl x:Class="SteamPlaytimeTracker.MVVM.View.SteamAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:usercontrols="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls" 
             xmlns:steam="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls.Steam"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF" 
             xmlns:data="clr-namespace:SteamPlaytimeTracker.Graphing.Data" 
             xmlns:viewmodel="clr-namespace:SteamPlaytimeTracker.MVVM.ViewModel" 
             d:DataContext="{d:DesignInstance Type=viewmodel:SteamAppViewModel}"
             xmlns:local="clr-namespace:SteamPlaytimeTracker.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource defaultGray}">
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*" MinWidth="50" MaxWidth="75" />
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <usercontrols:ExtendedButton x:Name="btn_BackToHomeView" Background="Transparent" HoverBackground="{StaticResource translucentGray}" 
                                         Foreground="LightGray"
                                         Command="{Binding SwitchBackToHomeViewCommand}"
                                         BorderThickness="0,0,1,1">
                <TextBlock Text="&lt;" FontSize="16" />
            </usercontrols:ExtendedButton>
            <Border Grid.Column="1" Background="Transparent" BorderBrush="DimGray" BorderThickness="0,0,0,1" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*" MinWidth="150" MaxWidth="200" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.4*" MinHeight="200" MaxHeight="400" />
                    <RowDefinition Height="0.6*" />
                </Grid.RowDefinitions>

                <Image Source="{Binding SelectedApp.SteamApp.ImageUrl}" Margin="5,5,5,0" />
                <TextBlock Grid.Row="1" Text="{Binding SelectedApp.SteamApp.Name}" 
                           Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" 
                           TextWrapping="Wrap" FontSize="12" Padding="5,0,5,0" />
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.8*"/>
                    <RowDefinition Height="0.2*" MinHeight="80"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Column="1" Content="{Binding Plot, Mode=OneTime}" />

                <Grid Grid.Row="1" Margin="5,0,5,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.3*" />
                        <RowDefinition Height="0.7*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.31*" MinHeight="26"/>
                            <RowDefinition Height="0.69*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.2*" MaxWidth="150" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding AvailableGraphingOptions}"
                                      SelectedItem="{Binding SelectedGraphingOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="IsSelectedByDefault"
                                      SelectedValue="True"
                                      Margin="2">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type data:GrapthViewSelectionData}">
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="0.2*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" HorizontalAlignment="Left" Margin="5,0,0,0" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Start Date:" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <DatePicker Grid.Column="1" Text="{Binding StartDateText, Mode=TwoWay}" SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                            DisplayDateStart="{Binding MinStartDate}" DisplayDateEnd="{Binding MaxEndDate}" 
                                            Margin="1,0,0,0" BorderThickness="0" />
                                    </Grid>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="End Date:" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <DatePicker Grid.Column="1" Text="{Binding EndDateText, Mode=TwoWay}" SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                            DisplayDateStart="{Binding MinStartDate}" DisplayDateEnd="{Binding MaxEndDate}"
                                            Margin="1,0,0,0" BorderThickness="0" IsEnabled="{Binding ShowEndDatePicker}" 
                                            Visibility="{Binding EndDatePickerVisiblity}" />
                                    </Grid>
                                </Grid>
                                <Grid Grid.Column="1" HorizontalAlignment="Right">
                                    <usercontrols:ExtendedButton Width="25" Height="25" Background="Transparent" Foreground="LightGray" 
                                             BorderThickness="0" HoverBackground="DimGray" PressedBackground="Gray" IsHitTestVisible="True"
                                             Command="{Binding ExportPlaytimeCommand}">
                                        <Path Data="{StaticResource ExportFileSVGData}"
                                           StrokeThickness="0" Fill="LightGray" Margin="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type usercontrols:ExtendedButton}}}"
                                           Stretch="Uniform" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                                    </usercontrols:ExtendedButton>
                                </Grid>
                            </Grid>
                        </Grid>

                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding TotalPlaytimeText}" Foreground="White" Background="Transparent" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
