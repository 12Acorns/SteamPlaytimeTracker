<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:moderndp="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls.Modern.DatePicker">
    <Style TargetType="{x:Type moderndp:DayOfWeek}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="{Binding Path=ActualWidth, RelativeSource={RelativeSource Mode=Self}}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="#999999" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type moderndp:DayOfWeek}">
                    <Border Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>