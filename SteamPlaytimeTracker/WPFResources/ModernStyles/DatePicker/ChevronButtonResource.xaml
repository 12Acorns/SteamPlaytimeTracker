<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:chevron="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls.Modern.Chevron">
    <Style TargetType="{x:Type chevron:ChevronButton}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#11FFFFFF"/>
        <Setter Property="Margin" Value="10 10 10 5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type chevron:ChevronButton}">
                    <Grid Background="{TemplateBinding Background}">
                        <Path x:Name="Path" Fill="{TemplateBinding Foreground}" Width="12" Height="12" Stretch="Uniform"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Direction" Value="Up">
                            <Setter TargetName="Path" Property="Data" Value="{StaticResource ChevronUpArrow}"/>
                        </Trigger>
                        <Trigger Property="Direction" Value="Down">
                            <Setter TargetName="Path" Property="Data" Value="{StaticResource ChevronDownArrow}"/>
                        </Trigger>
                        <Trigger Property="Direction" Value="Left">
                            <Setter TargetName="Path" Property="Data" Value="{StaticResource ChevronLeftArrow}"/>
                        </Trigger>
                        <Trigger Property="Direction" Value="Right">
                            <Setter TargetName="Path" Property="Data" Value="{StaticResource ChevronRightArrow}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{Binding HoverColour}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                        <Trigger x:Name="PART_PressedTrigger" Property="IsPressed" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>