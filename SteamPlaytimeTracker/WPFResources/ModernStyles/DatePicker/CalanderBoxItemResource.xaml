<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:datepicker="clr-namespace:SteamPlaytimeTracker.MVVM.View.UserControls.Modern.DatePicker">
    <Style x:Key="DayBoxStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Content,StringFormat={}{0}}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="{x:Type datepicker:CalanderBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#BB333333" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="{Binding Path=ActualWidth, RelativeSource={RelativeSource Mode=Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type datepicker:CalanderBoxItem}">
                    <Grid Background="Transparent">
                        <Border Background="{TemplateBinding Background}" Margin="2" CornerRadius="2" />
                        <TextBlock Style="{StaticResource DayBoxStyle}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCurrentMonth" Value="True">
                            <Setter Property="Foreground" Value="#303030" />
                        </Trigger>
                        <Trigger Property="IsCurrentDate" Value="True">
                            <Setter Property="Background" Value="#999999" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="CornflowerBlue" />
                            <Setter Property="Foreground" Value="#000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>